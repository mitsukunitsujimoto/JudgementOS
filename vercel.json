{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "output",
  "functions": {
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/jos-explained", "destination": "/jos-explained.html" },
    { "source": "/jos-explained/", "destination": "/jos-explained.html" },
    { "source": "/explained", "destination": "/jos-explained.html" },
    { "source": "/grill-me", "destination": "/grill-me.html" },
    { "source": "/grill-me/", "destination": "/grill-me.html" },
    { "source": "/judgment-structure-demo", "destination": "/judgment-structure-demo.html" },
    { "source": "/judgment-structure-demo/", "destination": "/judgment-structure-demo.html" }
  ]
}
